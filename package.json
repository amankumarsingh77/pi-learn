{
  "name": "pi-learn",
  "version": "0.1.0",
  "description": "A pi extension that teaches you a topic: it calibrates, maps the topic, explains with ASCII diagrams, asks one question at a time and diagnoses your reasoning, and keeps shareable notes.",
  "license": "MIT",
  "author": "amankumarsingh77",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amankumarsingh77/pi-learn.git"
  },
  "homepage": "https://github.com/amankumarsingh77/pi-learn#readme",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "learning",
    "tutor"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/bun": "latest",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/testing",
    "README.md",
    "LICENSE"
  ]
}
